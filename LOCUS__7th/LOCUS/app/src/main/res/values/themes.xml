<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LOCUS" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/locus_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/locus_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/locus_primary_dark</item>
        <item name="colorSecondary">@color/locus_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/locus_background</item>
        <item name="android:statusBarColor">@color/locus_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.LOCUS.Splash" parent="Theme.LOCUS">
        <item name="android:windowBackground">@color/locus_primary</item>
        <item name="android:statusBarColor">@color/locus_primary</item>
    </style>

    <style name="LocusCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/locus_surface</item>
    </style>
</resources>
