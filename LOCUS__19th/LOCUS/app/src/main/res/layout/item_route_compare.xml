<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LocusCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvRouteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/locus_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRouteStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/locus_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRouteDiff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/locus_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRouteRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
