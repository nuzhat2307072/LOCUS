<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LocusCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvTripTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/locus_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTripTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/locus_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTripRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/locus_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTripRemind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/locus_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTripDelete"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_delete" />

            <Button
                android:id="@+id/btnTripNavigate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_navigate" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
